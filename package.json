{
  "name": "babar",
  "version": "0.3.0",
  "description": "CLI bar charts",
  "main": "lib/babar.js",
  "types": "lib/babar.d.ts",
  "type": "commonjs",
  "scripts": {
    "build": "npm run build:bundle && npm run build:types",
    "build:bundle": "esbuild src/babar.ts --bundle --platform=node --format=cjs --minify --footer:js=\"module.exports=module.exports.default??module.exports;\" --outfile=lib/babar.js",
    "build:types": "tsc",
    "clean": "rimraf lib coverage",
    "preversion": "npm run clean",
    "version": "npm run build",
    "postversion": "git push && git push --tags && npm run clean",
    "prepublish": "npm run clean && npm run build",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/stephan83/babar.git"
  },
  "keywords": [
    "cli",
    "bar",
    "charts",
    "graph",
    "ascii"
  ],
  "author": "Stephan Florquin",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/stephan83/babar/issues"
  },
  "devDependencies": {
    "@types/node": "^20.0.0",
    "esbuild": "^0.28.0",
    "rimraf": "^3.0.2",
    "typescript": "^5.4.5",
    "vitest": "^1.6.0"
  }
}
