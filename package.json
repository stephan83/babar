{
  "name": "babar",
  "version": "1.0.0",
  "description": "CLI bar charts",
  "main": "lib/babar.js",
  "types": "lib/babar.d.ts",
  "type": "commonjs",
  "files": [
    "lib"
  ],
  "engines": {
    "node": ">=26.13"
  },
  "devEngines": {
    "runtime": {
      "name": "node",
      "version": "26.13.1",
      "onFail": "download"
    }
  },
  "scripts": {
    "build": "npm run build:bundle && npm run build:types",
    "build:bundle": "esbuild src/babar.ts --bundle --platform=node --format=cjs --minify --target=node26 --footer:js=\"module.exports.babar=module.exports.default=module.exports;\" --outfile=lib/babar.js",
    "build:types": "tsc",
    "typecheck": "tsc -p tsconfig.test.json",
    "clean": "rimraf lib coverage",
    "preversion": "npm run clean",
    "version": "npm run build",
    "postversion": "npm run clean",
    "prepack": "npm run build",
    "test": "npm run build && vitest run",
    "test:watch": "vitest"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/stephan83/babar.git"
  },
  "keywords": [
    "cli",
    "bar",
    "charts",
    "graph",
    "ascii"
  ],
  "author": "Stephan Florquin",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/stephan83/babar/issues"
  },
  "devDependencies": {
    "@types/node": "^20.0.0",
    "esbuild": "^0.28.0",
    "rimraf": "^3.0.2",
    "typescript": "^5.4.5",
    "vitest": "^1.6.0"
  }
}
